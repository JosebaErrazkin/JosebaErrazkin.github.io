---
import { textos } from '../i18n/ui';
import type { Idioma } from '../i18n/idiomas';

interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
const t = textos(idioma);
---

<dialog
  id="visor-imagenes"
  class="backdrop:bg-tinta/85 bg-transparent p-0 m-0 max-w-none max-h-none w-full h-full"
  aria-label={t.trayectoria.galeria}
>
  <div class="flex flex-col h-full w-full">
    <div class="flex items-center justify-between gap-4 p-3 text-papel">
      <p data-contador class="text-sm tabular-nums text-papel/70"></p>
      <button
        type="button"
        data-cerrar
        class="inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold bg-papel text-tinta rounded-full hover:bg-fuego hover:text-papel transition-colors"
      >
        {t.general.cerrar} ✕
      </button>
    </div>

    <div class="flex-1 flex items-center justify-center gap-2 px-2 pb-2 min-h-0">
      <button
        type="button"
        data-anterior
        class="shrink-0 w-11 h-11 rounded-full bg-papel/15 text-papel text-xl hover:bg-papel hover:text-tinta transition-colors"
        aria-label={t.general.anterior}>‹</button
      >
      <img data-imagen alt="" class="max-h-full max-w-full object-contain" />
      <button
        type="button"
        data-siguiente
        class="shrink-0 w-11 h-11 rounded-full bg-papel/15 text-papel text-xl hover:bg-papel hover:text-tinta transition-colors"
        aria-label={t.general.siguiente}>›</button
      >
    </div>

    <p data-pie class="text-center text-sm text-papel/80 px-6 pb-5"></p>
  </div>
</dialog>

<script is:inline define:vars={{ plantillaContador: t.trayectoria.imagenDe }}>
  (() => {
    const dialogo = document.getElementById('visor-imagenes');
    if (!(dialogo instanceof HTMLDialogElement)) return;

    const imagen = dialogo.querySelector('[data-imagen]');
    const pie = dialogo.querySelector('[data-pie]');
    const contador = dialogo.querySelector('[data-contador]');
    const botonAnterior = dialogo.querySelector('[data-anterior]');
    const botonSiguiente = dialogo.querySelector('[data-siguiente]');

    let grupo = [];
    let posicion = 0;
    let origen = null;

    const pintar = () => {
      const actual = grupo[posicion];
      if (!actual) return;
      imagen.src = actual.dataset.grande;
      imagen.alt = actual.dataset.alt ?? '';
      pie.textContent = actual.dataset.alt ?? '';
      contador.textContent = plantillaContador
        .replace('{n}', String(posicion + 1))
        .replace('{total}', String(grupo.length));
      const solaUna = grupo.length < 2;
      botonAnterior.hidden = solaUna;
      botonSiguiente.hidden = solaUna;
    };

    const mover = (paso) => {
      posicion = (posicion + paso + grupo.length) % grupo.length;
      pintar();
    };

    document.addEventListener('click', (evento) => {
      const disparador = evento.target.closest?.('[data-galeria]');
      if (!disparador) return;
      const nombre = disparador.dataset.galeria;
      grupo = Array.from(document.querySelectorAll(`[data-galeria="${nombre}"]`));
      posicion = grupo.indexOf(disparador);
      origen = disparador;
      pintar();
      dialogo.showModal();
    });

    botonAnterior.addEventListener('click', () => mover(-1));
    botonSiguiente.addEventListener('click', () => mover(1));
    dialogo.querySelector('[data-cerrar]').addEventListener('click', () => dialogo.close());

    dialogo.addEventListener('keydown', (evento) => {
      if (evento.key === 'ArrowRight') mover(1);
      if (evento.key === 'ArrowLeft') mover(-1);
    });

    // Cerrar al pulsar el fondo oscuro.
    dialogo.addEventListener('click', (evento) => {
      if (evento.target === dialogo) dialogo.close();
    });

    dialogo.addEventListener('close', () => origen?.focus());
  })();
</script>
