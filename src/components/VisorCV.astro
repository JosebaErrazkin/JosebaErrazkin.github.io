---
import DocumentoCV from './DocumentoCV.astro';
import { textos } from '../i18n/ui';
import {
  IDIOMAS_PUBLICADOS,
  NOMBRE_IDIOMA,
  SIGLA_IDIOMA,
  CODIGO_HREFLANG,
  type Idioma,
} from '../i18n/idiomas';
import { curriculum } from '../data';
import { recurso } from '../rutas';

/**
 * Ventana del currículum.
 *
 * Va una sola vez por página; el botón que la abre puede estar en varios
 * sitios (ver BotonCV.astro).
 *
 * El idioma que se elige aquí dentro solo afecta al currículum: la web sigue
 * en el suyo. El botón de descarga se escribe en el idioma de la web, pero
 * entrega el PDF del idioma que se esté viendo en ese momento.
 */
interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const t = textos(idioma);

const versiones = IDIOMAS_PUBLICADOS.map((otro) => ({
  idioma: otro,
  cv: curriculum(otro),
  pdf: recurso(`cv/${otro}.pdf`),
}));

const pdfs = Object.fromEntries(versiones.map((v) => [v.idioma, v.pdf]));
---

<dialog
  id="visor-cv"
  class="bg-transparent p-0 m-0 max-w-none max-h-none w-full h-full backdrop:bg-tinta/90"
  aria-label={t.presentacion.visorTitulo}
  data-pdfs={JSON.stringify(pdfs)}
>
  <div class="flex flex-col h-full">
    <!-- Barra superior: idiomas a la izquierda, descarga a la derecha -->
    <div class="flex items-center justify-between gap-3 p-3 bg-tinta text-papel">
      <fieldset class="flex items-center gap-1 min-w-0">
        <legend class="sr-only">{t.presentacion.idiomaDelCV}</legend>
        {
          IDIOMAS_PUBLICADOS.map((otro) => (
            <button
              type="button"
              data-idioma-cv={otro}
              lang={CODIGO_HREFLANG[otro]}
              aria-pressed={otro === idioma ? 'true' : 'false'}
              title={NOMBRE_IDIOMA[otro]}
              class="h-9 px-2.5 sm:px-3 rounded-md text-sm font-semibold border border-papel/25 text-papel/70 hover:text-papel hover:border-papel/60 transition-colors aria-pressed:bg-papel aria-pressed:text-tinta aria-pressed:border-papel"
            >
              <span aria-hidden="true">{SIGLA_IDIOMA[otro]}</span>
              <span class="sr-only">{NOMBRE_IDIOMA[otro]}</span>
            </button>
          ))
        }
      </fieldset>

      <div class="flex items-center gap-2 shrink-0">
        <a
          data-descargar-cv
          href={recurso(`cv/${idioma}.pdf`)}
          download={`Joseba-Errazkin-CV-${idioma}.pdf`}
          class="h-9 px-3 sm:px-4 inline-flex items-center gap-2 bg-fuego text-papel text-sm font-semibold rounded-md hover:bg-papel hover:text-tinta transition-colors"
        >
          <span aria-hidden="true">↓</span>
          <span class="hidden sm:inline">{t.presentacion.descargarCV}</span>
          <span class="sm:hidden">PDF</span>
        </a>

        <button
          type="button"
          data-cerrar-cv
          class="h-9 w-9 inline-flex items-center justify-center rounded-md bg-papel/10 border border-papel/25 hover:bg-papel hover:text-tinta transition-colors"
          aria-label={t.general.cerrar}>✕</button
        >
      </div>
    </div>

    <!-- El documento -->
    <div class="flex-1 overflow-y-auto bg-tinta/95 px-3 py-6 sm:px-6 sm:py-10">
      {
        versiones.map((version) => (
          <DocumentoCV cv={version.cv} idioma={version.idioma} oculto={version.idioma !== idioma} />
        ))
      }
    </div>
  </div>
</dialog>

<script>
  const dialogo = document.getElementById('visor-cv');

  if (dialogo instanceof HTMLDialogElement) {
    const pdfs: Record<string, string> = JSON.parse(dialogo.dataset.pdfs ?? '{}');
    const documentos = dialogo.querySelectorAll<HTMLElement>('[data-documento]');
    const botonesIdioma = dialogo.querySelectorAll<HTMLButtonElement>('[data-idioma-cv]');
    const descarga = dialogo.querySelector<HTMLAnchorElement>('[data-descargar-cv]');
    const zona = dialogo.querySelector<HTMLElement>('.overflow-y-auto');
    let ultimoBoton: HTMLElement | null = null;

    /** Cambia solo el currículum: la web se queda en su idioma. */
    const mostrar = (idiomaCV: string) => {
      for (const documento of documentos) {
        documento.hidden = documento.dataset.documento !== idiomaCV;
      }
      for (const boton of botonesIdioma) {
        boton.setAttribute(
          'aria-pressed',
          boton.dataset.idiomaCv === idiomaCV ? 'true' : 'false',
        );
      }
      if (descarga && pdfs[idiomaCV]) {
        descarga.href = pdfs[idiomaCV];
        descarga.setAttribute('download', `Joseba-Errazkin-CV-${idiomaCV}.pdf`);
      }
      zona?.scrollTo({ top: 0 });
    };

    for (const boton of botonesIdioma) {
      boton.addEventListener('click', () => mostrar(boton.dataset.idiomaCv!));
    }

    for (const abrir of document.querySelectorAll<HTMLElement>('[data-abrir-cv]')) {
      abrir.addEventListener('click', () => {
        ultimoBoton = abrir;
        dialogo.showModal();
      });
    }

    dialogo.querySelector('[data-cerrar-cv]')?.addEventListener('click', () => dialogo.close());
    dialogo.addEventListener('close', () => ultimoBoton?.focus());

    // Cerrar al pulsar fuera del documento.
    dialogo.addEventListener('click', (evento) => {
      if (evento.target === dialogo) dialogo.close();
    });
  }
</script>
