---
interface Props {
  titulo: string;
  entradilla?: string;
  rotulo?: string;
}
const { titulo, entradilla, rotulo } = Astro.props;
---

<section class="contenedor pt-14 pb-10 md:pt-20 md:pb-14">
  {
    rotulo && (
      <p class="text-xs md:text-sm uppercase tracking-[0.18em] font-semibold text-fuego-texto">
        {rotulo}
      </p>
    )
  }
  <h1 class="mt-3 text-4xl md:text-6xl leading-[0.95]">{titulo}</h1>
  <div class="mt-6 h-1 w-24 bg-fuego"></div>
  {entradilla && <p class="mt-6 max-w-2xl text-lg md:text-xl text-gris leading-relaxed">{entradilla}</p>}
</section>
