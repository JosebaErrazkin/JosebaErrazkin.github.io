---
import { textos } from '../i18n/ui';
import type { Idioma } from '../i18n/idiomas';

/**
 * Botón que abre la ventana del currículum. Puede repetirse en varios sitios
 * de la misma página: todos abren la misma ventana (VisorCV.astro), que solo
 * hace falta incluir una vez.
 */
interface Props {
  idioma: Idioma;
  /** "claro" para fondos oscuros, "oscuro" para fondos claros. */
  tono?: 'claro' | 'oscuro';
  clase?: string;
}

const { idioma, tono = 'oscuro', clase = '' } = Astro.props;
const t = textos(idioma);

const estilos =
  tono === 'claro'
    ? 'bg-fuego text-papel hover:bg-papel hover:text-tinta'
    : 'bg-tinta text-papel hover:bg-fuego';
---

<button
  type="button"
  data-abrir-cv
  class:list={[
    'h-12 px-7 inline-flex items-center gap-2 font-semibold rounded-lg transition-colors',
    estilos,
    clase,
  ]}
>
  {t.presentacion.verCV}
  <span aria-hidden="true">→</span>
</button>
