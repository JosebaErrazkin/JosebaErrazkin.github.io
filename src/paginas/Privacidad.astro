---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import TituloPagina from '../components/TituloPagina.astro';
import { textos } from '../i18n/ui';
import type { Idioma } from '../i18n/idiomas';

interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
const t = textos(idioma);

const entrada = await getEntry('legal', idioma);
if (!entrada) {
  throw new Error(`Falta el archivo src/content/legal/${idioma}.md con el aviso de privacidad.`);
}
const { Content } = await render(entrada);
---

<Base idioma={idioma} pagina="privacidad" sinRevisar={!entrada.data.revisado}>
  <TituloPagina rotulo={t.nav.privacidad} titulo={entrada.data.titulo} />

  <div class="contenedor pb-20">
    <div class="prosa max-w-2xl">
      <Content />
    </div>
  </div>
</Base>
