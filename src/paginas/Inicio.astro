---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { textos } from '../i18n/ui';
import type { Idioma } from '../i18n/idiomas';
import { ruta } from '../rutas';
import { DISPONIBILIDAD, imagen } from '../data';
import { SITIO } from '../config/sitio';

interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
const t = textos(idioma);
const disponibilidad = DISPONIBILIDAD[idioma];

const accesos = [
  {
    href: ruta('filosofia', idioma),
    titulo: t.inicio.accesoFilosofia,
    texto: t.inicio.accesoFilosofiaTexto,
    numero: '01',
  },
  {
    href: ruta('trayectoria', idioma),
    titulo: t.inicio.accesoTrayectoria,
    texto: t.inicio.accesoTrayectoriaTexto,
    numero: '02',
  },
  {
    href: ruta('especialidades', idioma),
    titulo: t.inicio.accesoEspecialidades,
    texto: t.inicio.accesoEspecialidadesTexto,
    numero: '03',
  },
];
---

<Base idioma={idioma} pagina="inicio">
  <!-- Portada -->
  <section class="relative bg-tinta text-papel overflow-hidden">
    <Image
      src={imagen('portada/entrenamiento.jpg')}
      alt=""
      widths={[640, 1024, 1600, 2400]}
      sizes="100vw"
      class="absolute inset-0 h-full w-full object-cover opacity-45"
      loading="eager"
      fetchpriority="high"
      aria-hidden="true"
    />
    <div
      class="absolute inset-0 bg-gradient-to-b from-tinta/85 via-tinta/60 to-tinta"
      aria-hidden="true"
    >
    </div>

    <div class="contenedor relative py-20 md:py-32 lg:py-40">
      <p class="text-xs md:text-sm uppercase tracking-[0.2em] font-semibold text-fuego">
        {t.inicio.rotulo}
      </p>
      <h1 class="mt-5 text-5xl md:text-7xl lg:text-8xl leading-[0.9]">
        Joseba<br />Errazkin
      </h1>
      <p class="mt-7 max-w-2xl text-lg md:text-2xl text-papel/85 leading-relaxed">
        {t.inicio.entradilla}
      </p>

      <div class="mt-10 flex flex-wrap gap-3">
        <a
          href={ruta('presentacion', idioma)}
          class="h-12 px-7 inline-flex items-center bg-fuego text-papel font-semibold rounded-lg hover:bg-papel hover:text-tinta transition-colors"
        >
          {t.inicio.verCV}
        </a>
        <a
          href={ruta('contacto', idioma)}
          class="h-12 px-7 inline-flex items-center border border-papel/40 font-semibold rounded-lg hover:bg-papel hover:text-tinta transition-colors"
        >
          {t.inicio.contactar}
        </a>
      </div>
    </div>
  </section>

  <!-- Situación profesional -->
  <section class="bg-papel-2 border-b border-linea">
    <div class="contenedor py-10">
      <h2 class="text-xs uppercase tracking-[0.18em] font-semibold text-gris">
        {t.inicio.disponibilidadTitulo}
      </h2>
      <dl class="mt-6 grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          disponibilidad.map((fila) => (
            <div class="border-t-2 border-fuego pt-3">
              <dt class="text-xs uppercase tracking-wider font-semibold text-gris">
                {fila.etiqueta}
              </dt>
              <dd class="mt-1.5 font-medium leading-snug">{fila.valor}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Por dónde empezar -->
  <section class="contenedor py-16 md:py-24">
    <h2 class="text-3xl md:text-4xl">{t.inicio.accesosTitulo}</h2>
    <ul class="mt-10 grid gap-5 md:grid-cols-3">
      {
        accesos.map((acceso) => (
          <li>
            <a
              href={acceso.href}
              class="group flex h-full flex-col border border-linea rounded-xl p-7 hover:border-tinta hover:shadow-lg transition-all bg-papel"
            >
              <span class="font-[family-name:var(--font-titulo)] text-fuego text-sm font-extrabold tracking-widest">
                {acceso.numero}
              </span>
              <h3 class="mt-3 text-2xl">{acceso.titulo}</h3>
              <p class="mt-3 text-gris flex-1">{acceso.texto}</p>
              <span
                class="mt-6 font-semibold text-tinta group-hover:text-fuego-texto transition-colors"
                aria-hidden="true"
              >
                →
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Cierre -->
  <section class="bg-tinta text-papel">
    <div class="contenedor py-16 md:py-20 grid gap-10 md:grid-cols-[1.2fr_1fr] md:items-center">
      <div>
        <h2 class="text-3xl md:text-5xl leading-tight">{t.inicio.contactar}</h2>
        <p class="mt-5 text-papel/80 max-w-lg">{t.contacto.entradilla}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={ruta('contacto', idioma)}
            class="h-12 px-7 inline-flex items-center bg-fuego text-papel font-semibold rounded-lg hover:bg-papel hover:text-tinta transition-colors"
          >
            {t.contacto.formularioTitulo}
          </a>
          <a
            href={`mailto:${SITIO.correo}`}
            class="h-12 px-7 inline-flex items-center border border-papel/40 font-semibold rounded-lg hover:bg-papel hover:text-tinta transition-colors break-all"
          >
            {SITIO.correo}
          </a>
        </div>
      </div>
      <Image
        src={imagen('portada/retrato.jpg')}
        alt=""
        widths={[400, 800]}
        sizes="(min-width: 768px) 380px, 100vw"
        class="w-full rounded-xl object-cover aspect-[4/5] md:aspect-[4/5]"
        loading="lazy"
        aria-hidden="true"
      />
    </div>
  </section>
</Base>
