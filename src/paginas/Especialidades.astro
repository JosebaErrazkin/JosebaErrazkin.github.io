---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import TituloPagina from '../components/TituloPagina.astro';
import { textos } from '../i18n/ui';
import type { Idioma } from '../i18n/idiomas';
import { CASOS, DEPORTES, imagen } from '../data';

interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
const t = textos(idioma);
const casos = CASOS[idioma];
const deportes = DEPORTES[idioma];
---

<Base idioma={idioma} pagina="especialidades">
  <TituloPagina
    rotulo={t.nav.especialidades}
    titulo={t.meta.especialidades.titulo}
    entradilla={t.especialidades.casosEntradilla}
  />

  <!-- Casos de readaptación -->
  <section class="contenedor pb-20" id="casos">
    <h2 class="text-3xl md:text-4xl">{t.especialidades.casosTitulo}</h2>

    <ul class="mt-10 grid gap-6 lg:grid-cols-2">
      {
        casos.map((caso) => (
          <li class="flex flex-col border border-linea rounded-xl overflow-hidden bg-papel">
            <div class="flex items-start justify-between gap-4 bg-tinta text-papel p-6">
              <div>
                <p class="text-xs uppercase tracking-[0.16em] font-semibold text-fuego">
                  {caso.deporte} · {caso.nivel}
                </p>
                <h3 class="mt-2 text-xl leading-snug">{caso.lesion}</h3>
              </div>
              <p class="shrink-0 text-right">
                <span class="block font-[family-name:var(--font-titulo)] text-4xl font-extrabold leading-none tabular-nums">
                  {caso.semanas}
                </span>
                <span class="block text-xs uppercase tracking-wider text-papel/60 mt-1">
                  {t.especialidades.semanas}
                </span>
              </p>
            </div>

            <div class="p-6 flex-1 flex flex-col gap-5">
              <div>
                <h4 class="text-xs uppercase tracking-wider font-semibold text-gris">
                  {t.especialidades.contexto}
                </h4>
                <p class="mt-1.5 leading-relaxed">{caso.contexto}</p>
              </div>

              <div>
                <h4 class="text-xs uppercase tracking-wider font-semibold text-gris">
                  {t.especialidades.intervencion}
                </h4>
                <ul class="mt-2 space-y-2">
                  {caso.intervencion.map((paso) => (
                    <li class="relative pl-5 text-gris leading-relaxed">
                      <span
                        class="absolute left-0 top-[0.7em] w-2.5 h-[3px] bg-fuego"
                        aria-hidden="true"
                      />
                      {paso}
                    </li>
                  ))}
                </ul>
              </div>

              <div class="mt-auto border-t-2 border-fuego pt-4">
                <h4 class="text-xs uppercase tracking-wider font-semibold text-gris">
                  {t.especialidades.resultado}
                </h4>
                <p class="mt-1.5 font-medium leading-relaxed">{caso.resultado}</p>
              </div>
            </div>
          </li>
        ))
      }
    </ul>

    <p class="mt-8 text-sm text-gris max-w-2xl">{t.especialidades.casosAviso}</p>
  </section>

  <!-- Preparación física por deporte -->
  <section class="bg-papel-2 border-y border-linea" id="deportes">
    <div class="contenedor py-16 md:py-20">
      <h2 class="text-3xl md:text-4xl">{t.especialidades.deportesTitulo}</h2>
      <p class="mt-4 max-w-2xl text-lg text-gris">{t.especialidades.deportesEntradilla}</p>

      <ul class="mt-12 space-y-12">
        {
          deportes.map((deporte, indice) => (
            <li
              class:list={[
                'grid gap-8 md:grid-cols-2 md:items-center',
                indice % 2 === 1 && 'md:[&>figure]:order-last',
              ]}
            >
              {deporte.imagen && (
                <figure class="m-0">
                  <Image
                    src={imagen(deporte.imagen.archivo)}
                    alt={deporte.imagen.alt}
                    widths={[400, 800, 1200]}
                    sizes="(min-width: 768px) 45vw, 100vw"
                    class="w-full rounded-xl object-cover aspect-[4/3]"
                    loading="lazy"
                  />
                </figure>
              )}

              <div>
                <h3 class="text-2xl md:text-3xl">{deporte.deporte}</h3>
                <p class="mt-3 text-gris leading-relaxed">{deporte.resumen}</p>

                <div class="mt-6 grid gap-6 sm:grid-cols-2">
                  <div>
                    <h4 class="text-xs uppercase tracking-wider font-semibold text-gris border-b border-linea pb-2">
                      {t.especialidades.exigencias}
                    </h4>
                    <ul class="mt-3 space-y-2 text-sm">
                      {deporte.exigencias.map((item) => (
                        <li class="relative pl-4 leading-relaxed">
                          <span
                            class="absolute left-0 top-[0.6em] w-2 h-[2px] bg-gris"
                            aria-hidden="true"
                          />
                          {item}
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div>
                    <h4 class="text-xs uppercase tracking-wider font-semibold text-fuego-texto border-b border-fuego pb-2">
                      {t.especialidades.enfoque}
                    </h4>
                    <ul class="mt-3 space-y-2 text-sm">
                      {deporte.enfoque.map((item) => (
                        <li class="relative pl-4 leading-relaxed">
                          <span
                            class="absolute left-0 top-[0.6em] w-2 h-[2px] bg-fuego"
                            aria-hidden="true"
                          />
                          {item}
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
