---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import TituloPagina from '../components/TituloPagina.astro';
import VisorCV from '../components/VisorCV.astro';
import { textos } from '../i18n/ui';
import type { Idioma } from '../i18n/idiomas';
import { imagen } from '../data';

interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
const t = textos(idioma);

const entrada = await getEntry('perfil', idioma);
if (!entrada) {
  throw new Error(
    `Falta el archivo src/content/perfil/${idioma}.md con la biografía en ese idioma.`,
  );
}
const { Content } = await render(entrada);
---

<Base idioma={idioma} pagina="presentacion" sinRevisar={!entrada.data.revisado}>
  <TituloPagina
    rotulo={t.nav.presentacion}
    titulo={entrada.data.titulo}
    entradilla={entrada.data.entradilla}
  />

  <div class="contenedor grid gap-12 lg:grid-cols-[1fr_360px] lg:gap-16 items-start pb-20">
    <div>
      <div class="prosa max-w-2xl">
        <Content />
      </div>

      <VisorCV idioma={idioma} />
    </div>

    <Image
      src={imagen('portada/retrato.jpg')}
      alt=""
      widths={[360, 720]}
      sizes="(min-width: 1024px) 360px, 100vw"
      class="w-full rounded-xl object-cover aspect-[4/5] lg:sticky lg:top-24"
      loading="lazy"
      aria-hidden="true"
    />
  </div>
</Base>
