---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import TituloPagina from '../components/TituloPagina.astro';
import Estrellas from '../components/Estrellas.astro';
import { textos } from '../i18n/ui';
import type { Idioma } from '../i18n/idiomas';
import { TESTIMONIOS, imagen } from '../data';

interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
const t = textos(idioma);
const testimonios = TESTIMONIOS[idioma];

/** Iniciales para quien no tiene foto publicada. */
const iniciales = (nombre: string) =>
  nombre
    .split(' ')
    .slice(0, 2)
    .map((parte) => parte[0]?.toUpperCase() ?? '')
    .join('');
---

<Base idioma={idioma} pagina="valoraciones">
  <TituloPagina
    rotulo={t.nav.valoraciones}
    titulo={t.meta.valoraciones.titulo}
    entradilla={t.valoraciones.entradilla}
  />

  <div class="contenedor pb-20">
    <ul class="grid gap-6 md:grid-cols-2 lg:gap-8">
      {
        testimonios.map((testimonio) => (
          <li class="flex flex-col border border-linea rounded-xl p-7 bg-papel">
            {testimonio.estrellas !== undefined && (
              <p class="mb-4">
                <Estrellas valor={testimonio.estrellas} idioma={idioma} />
              </p>
            )}

            <blockquote class="flex-1">
              <p class="text-lg leading-relaxed before:content-['«'] after:content-['»'] before:text-fuego after:text-fuego before:mr-1 after:ml-1">
                {testimonio.texto}
              </p>
            </blockquote>

            <div class="mt-6 flex items-center gap-4 border-t border-linea pt-5">
              {testimonio.foto ? (
                <Image
                  src={imagen(testimonio.foto.archivo)}
                  alt={testimonio.foto.alt}
                  width={112}
                  height={112}
                  widths={[112, 224]}
                  sizes="56px"
                  class="w-14 h-14 rounded-full object-cover shrink-0"
                  loading="lazy"
                />
              ) : (
                <span
                  class="w-14 h-14 rounded-full shrink-0 bg-tinta text-papel font-[family-name:var(--font-titulo)] font-extrabold flex items-center justify-center"
                  aria-hidden="true"
                >
                  {iniciales(testimonio.nombre)}
                </span>
              )}

              <span class="min-w-0">
                <span class="block font-semibold">{testimonio.nombre}</span>
                <span class="block text-sm text-gris">
                  {testimonio.cargo}
                  {testimonio.entidad && ` · ${testimonio.entidad}`}
                </span>
              </span>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</Base>
